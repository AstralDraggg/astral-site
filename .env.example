# Скопируй этот файл в .env для локальной разработки.
# На Vercel те же переменные задаются в дашборде: Settings -> Environment Variables.

# --- База данных (Turso, бесплатный тариф) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Секрет для токенов входа (придумай длинную строку из случайных символов) ---
TOKEN_SECRET=

# --- Почта для кодов подтверждения ---
# Вариант A (работает без своего домена): SMTP с твоего почтового ящика.
# Gmail: включи 2FA и создай пароль приложения, SMTP_HOST=smtp.gmail.com
# Yandex: SMTP_HOST=smtp.yandex.ru   Mail.ru: SMTP_HOST=smtp.mail.ru
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Вариант B: Resend (https://resend.com) — требует верифицированный домен.
RESEND_API_KEY=
# EMAIL_FROM="Astral <noreply@ваш-домен>"

# Общий адрес отправителя (необязательно, по умолчанию берётся из SMTP_USER)
# EMAIL_FROM="Astral <my@mail.ru>"

# --- Лаунчер ---
# Прямая ссылка на Astral.exe (например, релиз на GitHub) —30 МБ файл
# не помещается в серверлес-функцию, поэтому отдаётся ссылкой.
LAUNCHER_URL=
LAUNCHER_FILE=Astral.exe

# Режим без настроенной почты: код возвращается в ответе (только локально,
# на Vercel не работает — там NODE_ENV=production).
# ALLOW_DEV_CODES=true
